#normalization model taking into account the stimulus drive (no stimulus suppression)

import numpy as np
import matplotlib.pyplot as plt

def gaussian(x, mu, sigma):
    """Simple 1D Gaussian"""
    return np.exp(-0.5 * ((x - mu) / sigma) ** 2)

def normalization_model(x, stimulus_center, stimulus_width,
                        attention_center, attention_width, sigma=1.0):
    """
    x                -- 1D array (spatial positions)
    stimulus_center  -- center of stimulus (int or float)
    stimulus_width   -- width (std dev) of stimulus Gaussian
    attention_center -- center of attention field
    attention_width  -- width (std dev) of attention field
    sigma            -- semi-saturation constant
    """
    # Stimulus profile
    S = gaussian(x, stimulus_center, stimulus_width)
    # Attention profile
    A = gaussian(x, attention_center, attention_width)

    # Stimulus Drive (modulated by Attention)
    E = A * S

    # Normalization denominator
    norm_den = sigma + np.sum(E)

    # Normalized response
    R = E / norm_den

    # Plot
    plt.figure(figsize=(7,4))
    plt.plot(x, S, label='Stimulus S(x)')
    plt.plot(x, A, label='Attention A(x)')
    plt.plot(x, R, label='Normalized Response R(x)')
    plt.xlabel('Position x')
    plt.legend()
    plt.title('Simplified Normalization Model')
    plt.tight_layout()
    plt.show()

    return R

# Example usage:
x = np.linspace(-50, 50, 100)
resp = normalization_model(
    x,
    stimulus_center=0,    # center of stimulus at position 0
    stimulus_width=40,    # stimulus spread
    attention_center=0,   # attention centered at 0
    attention_width=30,    # focus size
    sigma=1.0             # normalization constant
)
